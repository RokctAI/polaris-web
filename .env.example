# polaris-web - environment variables this shell reads.
#
# Copy to .env.local for local development. Never commit real values: secrets
# live in the private RokctAI/occultation workspace and are set in the Vercel
# project's Environment Variables, not in this file.

# ---------------------------------------------------------------------------
# Public identity of this deployment (app/site.ts).
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL: the public origin, no trailing slash. Read by
# app/site.ts (robots.txt, sitemap.xml) and by base_sdk's composed
# app/lib/site-metadata.ts (metadataBase, canonical URL, the generated
# favicon letter and link-preview host line). Unset, both fall back to
# Vercel's production URL, then to localhost.
# NEXT_PUBLIC_SITE_NAME: what the wordmark and the web app manifest print.
# Unset, the app_type this repo was spawned with is used.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=

# ---------------------------------------------------------------------------
# Rokct platform gateway.
# ---------------------------------------------------------------------------
# Base origin of the Frappe backend. Read by the base_sdk platform client
# (core/base/nextjs/src/services/platform-gateway.ts), which appends the single
# gateway path /api/v1/method/rokct.platform.api and names the target method in
# the request's `cmd` field. Server-side value first, public fallback second.
# Neither is read at build time.
ROKCT_BASE_URL=
NEXT_PUBLIC_ROKCT_BASE_URL=

# ---------------------------------------------------------------------------
# Added by composed SDKs - declare them here when the SDK joins composer.json.
# ---------------------------------------------------------------------------
# auth_sdk: AUTH_SECRET (NextAuth signing secret, runtime only), and
# ROKCT_ADMIN_API_KEY / ROKCT_ADMIN_API_SECRET for /register when the
# single-tenant link is selected in next.config.mjs. No POSTGRES_URL in that
# configuration.
